# ============================================
# Anthropic API Key (必填)
# 获取: https://console.anthropic.com/
# ============================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ============================================
# 足球数据 API (至少配置一个, 否则使用模拟数据)
# ============================================

# --- 方案 A: API-Football (推荐) ---
# 覆盖全球 100+ 联赛, 包含射门/控球/犯规等详细数据
# 注册: https://rapidapi.com/api-sports/api/api-football/
# 免费额度: ~100 请求/天
FOOTBALL_RAPIDAPI_KEY=xxxxxxxxxxxxxxxx

# --- 方案 B: football-data.org ---
# 覆盖欧洲五大联赛 + 欧冠
# 注册: https://www.football-data.org/
# 免费额度: 10 请求/分钟
# FOOTBALL_DATA_API_KEY=xxxxxxxxxxxxxxxx

# --- 方案 C: The Odds API ---
# 覆盖 40+ 博彩公司实时赔率 (Bet365/Pinnacle/William Hill...)
# 注册: https://the-odds-api.com/
# 免费额度: 500 请求/月
# THE_ODDS_API_KEY=xxxxxxxxxxxxxxxx

# ============================================
# 服务器配置
# ============================================
HOST=0.0.0.0
PORT=8000
